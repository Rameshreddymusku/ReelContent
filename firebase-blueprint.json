{
  "entities": {
    "Booking": {
      "title": "Booking",
      "description": "A reel shoot studio slot booking with confirmation order, ticket, and user region.",
      "type": "object",
      "properties": {
        "orderId": {
          "type": "string",
          "description": "Unique confirmation order identifier",
          "minLength": 4,
          "maxLength": 40,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "ticketId": {
          "type": "string",
          "description": "Unique confirmation ticket code",
          "minLength": 4,
          "maxLength": 40,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "userId": {
          "type": "string",
          "description": "UID of the user who created the booking",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "customerName": {
          "type": "string",
          "description": "Customer full name",
          "minLength": 1,
          "maxLength": 80
        },
        "customerEmail": {
          "type": "string",
          "format": "email",
          "description": "Customer email address for Gmail confirmation",
          "minLength": 3,
          "maxLength": 120
        },
        "customerPhone": {
          "type": "string",
          "description": "Customer phone or WhatsApp number",
          "minLength": 3,
          "maxLength": 30
        },
        "region": {
          "type": "string",
          "description": "Geographic region the user is coming from (visible to Studio Admin)",
          "minLength": 2,
          "maxLength": 80
        },
        "timezone": {
          "type": "string",
          "description": "Detected IANA timezone of the user",
          "minLength": 2,
          "maxLength": 60
        },
        "dateStr": {
          "type": "string",
          "description": "Shoot date string in YYYY-MM-DD format",
          "minLength": 10,
          "maxLength": 10,
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "slotTime": {
          "type": "string",
          "description": "Shoot time range, e.g., 13:30 - 15:00",
          "minLength": 5,
          "maxLength": 30
        },
        "packageName": {
          "type": "string",
          "description": "Selected studio shoot package name",
          "enum": ["Creator", "Brand Pro", "Full Production"],
          "minLength": 3,
          "maxLength": 30
        },
        "price": {
          "type": "number",
          "description": "Package price in USD"
        },
        "status": {
          "type": "string",
          "description": "Booking confirmation status",
          "enum": ["CONFIRMED", "CANCELLED"],
          "minLength": 6,
          "maxLength": 15
        },
        "gmailSent": {
          "type": "boolean",
          "description": "Whether confirmation order email was sent via Gmail"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of booking creation"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of booking update"
        }
      },
      "required": [
        "orderId",
        "ticketId",
        "userId",
        "customerName",
        "customerEmail",
        "customerPhone",
        "region",
        "timezone",
        "dateStr",
        "slotTime",
        "packageName",
        "price",
        "status",
        "gmailSent",
        "createdAt",
        "updatedAt"
      ]
    },
    "ContactInquiry": {
      "title": "ContactInquiry",
      "description": "Contact message sent to Studio 04 with sender region telemetry.",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "description": "UID of the sender",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "name": {
          "type": "string",
          "description": "Sender name",
          "minLength": 1,
          "maxLength": 80
        },
        "email": {
          "type": "string",
          "format": "email",
          "description": "Sender email",
          "minLength": 3,
          "maxLength": 120
        },
        "message": {
          "type": "string",
          "description": "Reel shoot inquiry message",
          "minLength": 1,
          "maxLength": 1000
        },
        "region": {
          "type": "string",
          "description": "Geographic region of the sender",
          "minLength": 2,
          "maxLength": 80
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when inquiry was submitted"
        }
      },
      "required": ["userId", "name", "email", "message", "region", "createdAt"]
    },
    "RegionVisit": {
      "title": "RegionVisit",
      "description": "User regional session record so Studio Admin knows which region each user is coming from.",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "description": "Authenticated user UID",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "userEmail": {
          "type": "string",
          "description": "Authenticated user email",
          "minLength": 3,
          "maxLength": 120
        },
        "region": {
          "type": "string",
          "description": "Region name (e.g., South Asia · India, North America · US-West)",
          "minLength": 2,
          "maxLength": 80
        },
        "timezone": {
          "type": "string",
          "description": "IANA timezone string",
          "minLength": 2,
          "maxLength": 60
        },
        "language": {
          "type": "string",
          "description": "Browser locale code",
          "minLength": 2,
          "maxLength": 20
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of regional check-in"
        }
      },
      "required": ["userId", "userEmail", "region", "timezone", "language", "updatedAt"]
    }
  },
  "firestore": {
    "/bookings/{bookingId}": {
      "schema": { "$ref": "#/entities/Booking" },
      "description": "Stores studio shoot bookings, confirmation orders, and tickets."
    },
    "/inquiries/{inquiryId}": {
      "schema": { "$ref": "#/entities/ContactInquiry" },
      "description": "Stores contact messages submitted to Studio 04."
    },
    "/region_visits/{visitId}": {
      "schema": { "$ref": "#/entities/RegionVisit" },
      "description": "Stores user regional presence for the Studio Admin dashboard."
    }
  }
}
