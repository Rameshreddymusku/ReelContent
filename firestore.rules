rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // 2. Primitive Helpers
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    // Bootstrapped Studio Admin check without DB lookup so list queries remain O(1)
    function isAdmin() {
      return isVerifiedUser() && request.auth.token.email == 'rameshreddymusku18@gmail.com';
    }

    // 3. Entity Validation Blueprints
    function isValidBooking(data) {
      return data.keys().hasAll([
        'orderId', 'ticketId', 'userId', 'customerName', 'customerEmail',
        'customerPhone', 'region', 'timezone', 'dateStr', 'slotTime',
        'packageName', 'price', 'status', 'gmailSent', 'createdAt', 'updatedAt'
      ]) &&
      data.keys().hasOnly([
        'orderId', 'ticketId', 'userId', 'customerName', 'customerEmail',
        'customerPhone', 'region', 'timezone', 'dateStr', 'slotTime',
        'packageName', 'price', 'status', 'gmailSent', 'createdAt', 'updatedAt'
      ]) &&
      data.orderId is string && data.orderId.size() >= 4 && data.orderId.size() <= 40 && data.orderId.matches('^[a-zA-Z0-9_\\-]+$') &&
      data.ticketId is string && data.ticketId.size() >= 4 && data.ticketId.size() <= 40 && data.ticketId.matches('^[a-zA-Z0-9_\\-]+$') &&
      data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 && data.userId.matches('^[a-zA-Z0-9_\\-]+$') &&
      data.userId == request.auth.uid &&
      data.customerName is string && data.customerName.size() >= 1 && data.customerName.size() <= 80 &&
      data.customerEmail is string && data.customerEmail.size() >= 3 && data.customerEmail.size() <= 120 &&
      data.customerPhone is string && data.customerPhone.size() >= 3 && data.customerPhone.size() <= 30 &&
      data.region is string && data.region.size() >= 2 && data.region.size() <= 80 &&
      data.timezone is string && data.timezone.size() >= 2 && data.timezone.size() <= 60 &&
      data.dateStr is string && data.dateStr.size() == 10 && data.dateStr.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$') &&
      data.slotTime is string && data.slotTime.size() >= 5 && data.slotTime.size() <= 30 &&
      data.packageName is string && data.packageName.size() >= 3 && data.packageName.size() <= 30 &&
      (data.packageName == 'Creator' || data.packageName == 'Brand Pro' || data.packageName == 'Full Production') &&
      data.price is number && data.price >= 0 && data.price <= 10000 &&
      data.status is string && data.status.size() >= 6 && data.status.size() <= 15 &&
      (data.status == 'CONFIRMED' || data.status == 'CANCELLED') &&
      data.gmailSent is bool &&
      data.createdAt is timestamp &&
      data.updatedAt is timestamp;
    }

    function isValidInquiry(data) {
      return data.keys().hasAll(['userId', 'name', 'email', 'message', 'region', 'createdAt']) &&
      data.keys().hasOnly(['userId', 'name', 'email', 'message', 'region', 'createdAt']) &&
      data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 && data.userId.matches('^[a-zA-Z0-9_\\-]+$') &&
      data.userId == request.auth.uid &&
      data.name is string && data.name.size() >= 1 && data.name.size() <= 80 &&
      data.email is string && data.email.size() >= 3 && data.email.size() <= 120 &&
      data.message is string && data.message.size() >= 1 && data.message.size() <= 1000 &&
      data.region is string && data.region.size() >= 2 && data.region.size() <= 80 &&
      data.createdAt is timestamp;
    }

    function isValidRegionVisit(data) {
      return data.keys().hasAll(['userId', 'userEmail', 'region', 'timezone', 'language', 'updatedAt']) &&
      data.keys().hasOnly(['userId', 'userEmail', 'region', 'timezone', 'language', 'updatedAt']) &&
      data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 && data.userId.matches('^[a-zA-Z0-9_\\-]+$') &&
      data.userId == request.auth.uid &&
      data.userEmail is string && data.userEmail.size() >= 3 && data.userEmail.size() <= 120 &&
      data.region is string && data.region.size() >= 2 && data.region.size() <= 80 &&
      data.timezone is string && data.timezone.size() >= 2 && data.timezone.size() <= 60 &&
      data.language is string && data.language.size() >= 2 && data.language.size() <= 20 &&
      data.updatedAt is timestamp;
    }

    // 4. Collection Rules
    match /test/{docId} {
      allow get: if isValidId(docId);
      allow list, create, update, delete: if false;
    }

    match /bookings/{bookingId} {
      allow get: if isVerifiedUser() && isValidId(bookingId) && (existing().userId == request.auth.uid || isAdmin());
      allow list: if isVerifiedUser() && (existing().userId == request.auth.uid || isAdmin());
      allow create: if isVerifiedUser() &&
        isValidId(bookingId) &&
        isValidBooking(incoming()) &&
        incoming().status == 'CONFIRMED' &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;
      allow update: if isVerifiedUser() &&
        isValidId(bookingId) &&
        isValidBooking(incoming()) &&
        incoming().userId == existing().userId &&
        incoming().orderId == existing().orderId &&
        incoming().ticketId == existing().ticketId &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time && (
          isAdmin() || (
            existing().userId == request.auth.uid &&
            existing().status != 'CANCELLED' && (
              // Action 1: Cancel Booking
              (incoming().status == 'CANCELLED' &&
               incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt'])) ||
              // Action 2: Mark Gmail Confirmation Sent
              (incoming().gmailSent == true &&
               incoming().diff(existing()).affectedKeys().hasOnly(['gmailSent', 'updatedAt']))
            )
          )
        );
      allow delete: if false;
    }

    match /inquiries/{inquiryId} {
      allow get: if isVerifiedUser() && isValidId(inquiryId) && (existing().userId == request.auth.uid || isAdmin());
      allow list: if isVerifiedUser() && (existing().userId == request.auth.uid || isAdmin());
      allow create: if isVerifiedUser() &&
        isValidId(inquiryId) &&
        isValidInquiry(incoming()) &&
        incoming().createdAt == request.time;
      allow update, delete: if false;
    }

    match /region_visits/{visitId} {
      allow get: if isVerifiedUser() && isValidId(visitId) && (existing().userId == request.auth.uid || isAdmin());
      allow list: if isVerifiedUser() && (existing().userId == request.auth.uid || isAdmin());
      allow create: if isVerifiedUser() &&
        isValidId(visitId) &&
        visitId == request.auth.uid &&
        isValidRegionVisit(incoming()) &&
        incoming().updatedAt == request.time;
      allow update: if isVerifiedUser() &&
        isValidId(visitId) &&
        visitId == request.auth.uid &&
        isValidRegionVisit(incoming()) &&
        existing().userId == request.auth.uid &&
        incoming().userId == existing().userId &&
        incoming().updatedAt == request.time && (
          isAdmin() ||
          incoming().diff(existing()).affectedKeys().hasOnly(['region', 'timezone', 'language', 'userEmail', 'updatedAt'])
        );
      allow delete: if false;
    }
  }
}
